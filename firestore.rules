rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper to validate User schema
    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email is string
        && data.chips is int
        && data.referralCode is string
        && data.chips >= 0;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
        && isValidUser(incoming())
        && incoming().chips == 1000 // Initial bonus chips
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == userId // immutable
        && incoming().referralCode == existing().referralCode // immutable
        && (
          // Action: Balance update (spins or transactions)
          incoming().diff(existing()).affectedKeys().hasOnly(['chips', 'photoURL', 'displayName'])
        );
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() 
        && incoming().uid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().amount > 0
        && incoming().createdAt == request.time;
    }

    match /spins/{spinId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && incoming().uid == request.auth.uid
        && incoming().betAmount > 0
        && incoming().createdAt == request.time;
    }
  }
}
